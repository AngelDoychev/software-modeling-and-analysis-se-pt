</mxCell><mxCell id="n184" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="n183"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n185" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="n183"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n186" value="" style="edgeStyle=entityRelationEdgeStyle;endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="n113" target="n47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n187" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="n186"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n188" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="n186"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n189" value="&lt;b&gt;Fact constellation (galaxy schema)&lt;/b&gt;&lt;br&gt;4 таблици факти (червени) споделят 7 таблици измерения (сини).&lt;br&gt;DimUser е role-playing измерение - свързва се и като продавач (SellerKey), и като купувач (BuyerKey).&lt;br&gt;DimDate се ползва за дата на поръчка, доставка, публикуване, промоция и оценка.&lt;br&gt;OrderId / PromotionId / ReviewId - degenerate dimension." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>